# Maintainer: Angelo Scarnà <angelo.scarna@primanotanet.it>
#
# Pacchetto per "Orme" (nome interno/CMake/eseguibile: Orme), raccolta di
# giochi educativi Qt6/QML per bambini 3-5 anni.
#
# I sorgenti non vengono scaricati da rete: il Dockerfile che prepara questo
# ambiente di build copia l'albero del repo in /home/builder/orme-source
# PRIMA di invocare makepkg, quindi source=() e build()/package() puntano
# direttamente lì.
pkgname=orme-archlinux
# Letta dal file VERSION alla radice del repo (unica fonte del numero di
# versione: per un nuovo rilascio si modifica solo quello, non questo file).
# Path letterale invece di $_upstream_src perche' questa riga viene eseguita
# prima che _upstream_src sia assegnata, piu' sotto.
pkgver=$(cat /home/builder/orme-source/VERSION)
pkgrel=1
pkgdesc="Orme - raccolta di giochi educativi Qt6/QML per bambini 3-5 anni"
arch=('x86_64')
license=('GPL-3.0-or-later')
depends=('qt6-base' 'qt6-declarative' 'qt6-multimedia')
makedepends=('cmake')
source=()
sha256sums=()
# Niente pacchetto -debug separato: non serve agli utenti finali e
# altrimenti finisce anche lui tra gli allegati della release.
options=('!debug')

_upstream_src=/home/builder/orme-source

build() {
  cmake -S "$_upstream_src" -B "$srcdir/build" \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build "$srcdir/build"
}

package() {
  DESTDIR="$pkgdir" cmake --install "$srcdir/build"
  install -Dm644 "$_upstream_src/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$_upstream_src/COPYRIGHT" "$pkgdir/usr/share/licenses/$pkgname/COPYRIGHT"
}
