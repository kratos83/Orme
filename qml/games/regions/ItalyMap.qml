    implicitHeight: mapH

    // mare: sfondo distinto dallo sfondo della pagina, cosi' la sagoma delle
    // regioni si legge subito come una mappa
    Rectangle {
        anchors.fill: parent
        radius: 20
        color: "#BBDEFB"
    }

    function regionColor(index, id) {
        if (root.answered) {
            if (id === root.correctId) return Theme.accent
            return Qt.rgba(0.55, 0.55, 0.55, 1)
        }
        if (id === root.wrongId) return Theme.danger
        return Theme.playColors[index % Theme.playColors.length]
    }

    Repeater {
        model: root.regions
        Shape {
            id: shape
            required property var modelData
            required property int index
            anchors.fill: parent
            preferredRendererType: Shape.CurveRenderer
            ShapePath {
                strokeWidth: 1.5
                strokeColor: "#FFFFFF"
                fillColor: root.regionColor(shape.index, shape.modelData.id)
                joinStyle: ShapePath.RoundJoin
                Behavior on fillColor { ColorAnimation { duration: 120 } }
                PathPolyline { path: shape.modelData.pts }
            }
        }
    }

    // nomi delle regioni, centrati sul baricentro di ciascuna sagoma
    Repeater {
        model: root.regions
        Text {
            required property var modelData
            x: modelData.cx - width / 2
            y: modelData.cy - height / 2
            width: 92
            height: 30
            horizontalAlignment: Text.AlignHCenter
            verticalAlignment: Text.AlignVCenter
            text: modelData.name
            color: "white"
            font.bold: true
            font.pixelSize: 13
            fontSizeMode: Text.Fit
            minimumPixelSize: 7
            wrapMode: Text.WordWrap
            style: Text.Outline
            styleColor: Qt.rgba(0, 0, 0, 0.45)
        }
    }

    function pointInPolygon(px, py, pts) {
        var inside = false
        for (var i = 0, j = pts.length - 1; i < pts.length; j = i++) {
            var xi = pts[i].x, yi = pts[i].y
            var xj = pts[j].x, yj = pts[j].y
            var intersect = ((yi > py) !== (yj > py)) &&
                (px < (xj - xi) * (py - yi) / (yj - yi) + xi)
            if (intersect) inside = !inside
        }
        return inside
    }

    // trova la regione toccata: prima un test esatto punto-in-poligono, poi
    // (se il dito ha mancato di poco un confine sottile) la regione con il
    // baricentro più vicino entro una piccola tolleranza
    function findRegionAt(px, py) {
        for (var i = 0; i < root.regions.length; i++) {
            if (pointInPolygon(px, py, root.regions[i].pts))
                return root.regions[i].id
        }
        var best = null
        var bestDist = 28
        for (var k = 0; k < root.regions.length; k++) {
            var dx = px - root.regions[k].cx
            var dy = py - root.regions[k].cy
            var dist = Math.sqrt(dx * dx + dy * dy)
            if (dist < bestDist) { bestDist = dist; best = root.regions[k].id }
        }
        return best
    }

    MouseArea {
        anchors.fill: parent
        enabled: !root.answered
        onClicked: (mouse) => {
            var hit = root.findRegionAt(mouse.x, mouse.y)
            if (hit) root.regionTapped(hit)
        }
    }
}
